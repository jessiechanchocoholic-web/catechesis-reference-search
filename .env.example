# Copy to .dev.vars for local `wrangler dev`. Never commit the real key.
# Production: Cloudflare dashboard → Worker → Settings → Variables and Secrets
# → Add secret named POE_API_KEY (Encrypt). Do not put it in wrangler.jsonc.
POE_API_KEY="YOUR_POE_API_KEY"

# Optional. Defaults live in wrangler.jsonc vars and can be overridden in the dashboard.
# MODEL is the Poe bot for library search, PDF/image reading, and classification.
MODEL="Claude-Haiku-5.5"
# WEB_SEARCH_MODEL must be a Poe bot that searches the web. Poe routes web searches to Web-Search.
WEB_SEARCH_MODEL="Web-Search"
